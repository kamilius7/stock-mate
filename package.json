{
  "name": "stockmate",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8080 --host lan",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsx src/tests/workflows.ts && eslint src/app src/components/stockmate src/theme src/services src/types src/state src/screens src/tests && expo export --platform all --max-workers 2",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/app src/components/stockmate src/theme src/services src/types src/state src/screens src/tests",
    "test": "tsx src/tests/workflows.ts",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-router": "~6.0.19",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-status-bar": "~3.0.9",
    "expo-font": "~14.0.10",
    "@expo/vector-icons": "^15.0.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "~0.21.2",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/node": "^22.5.5",
    "typescript": "~5.9.2",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "typescript-eslint": "^8.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "tsx": "^4.20.6",
    "expo-doctor": "^1.17.11"
  }
}
