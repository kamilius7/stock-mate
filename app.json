{
  "expo": {
    "name": "StockMate",
    "slug": "stockmate",
    "scheme": "stockmate",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.stockmate.app" },
    "android": { "package": "com.stockmate.app", "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "single", "name": "StockMate" },
    "plugins": ["expo-router", "expo-font"]
  }
}
